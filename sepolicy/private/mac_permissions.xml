<?xml version="1.0" encoding="utf-8"?>
<!--
  seinfo=oplus_app for the stock OPlus camera app.

  The signature below is the RAW DER of the OplusCamera.apk v1 (JAR) signing
  certificate, hex-encoded.  system/sepolicy/tools/insertkeys.py passes any
  signature= value that is not a @TAG through verbatim (ReplaceTags.startElement
  substitutes only when `value in self._keyMap`), so no keys.conf entry and no
  .pem file are needed.

  Provenance / cross-check (both computed on the builder):
    ktm-16.0.10 system_ext_mac_permissions.xml <signer> for com.oplus.camera
      -> 1007 bytes DER, sha256
         b0a9bbfc05eee5e7d0a2c97c030586e15bb3301152078f54473bb82df6d8c818
    META-INF/CERT.RSA of my_product/app/OplusCamera/OplusCamera.apk
      -> 1007 bytes DER, same sha256
    vendor/oneplus/ktm-opluscamera/proprietary/product/app/OplusCamera/OplusCamera.apk
      -> same sha256
    Subject: C=CN, ST=GuangDong, L=DongGuan, O=Oplus, OU=OSTeam,
             CN=AndroidTeam, emailAddress=oplus@oplus.com
  The two hex strings are byte-for-byte identical (2014 hex chars).

  NOTE: apksigner could not be used - there is no JRE on the builder.  The DER
  was pulled straight out of the PKCS#7 SignedData in META-INF/CERT.RSA and
  parsed with python-cryptography (x509.load_der_x509_certificate).

  The APK must be installed PRESIGNED (LOCAL_CERTIFICATE := PRESIGNED) or this
  will never match.

  Stock also maps this seinfo onto com.android.cameraextensions and
  com.android.oemextensions, but under a DIFFERENT signer cert
  (sha256 fc98dae63ad39626c8c67fbe83f2f06f74932a9cd146b92cecfc6a047a904386).
  Neither package ships in a form we reuse, so that signer is omitted.
-->
<policy>
    <signer signature="">
        <package name="com.oplus.camera">
            <seinfo value="oplus_app"/>
        </package>
    </signer>
</policy>
