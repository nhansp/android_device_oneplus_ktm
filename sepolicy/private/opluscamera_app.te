# OPlus stock camera app (com.oplus.camera) - core/system_ext half.
#
# Derived from ktm-16.0.10 system_ext_sepolicy.cil lines 6935-7031, 9547-9559
# (140 CIL lines mention opluscamera_app), macro-matched with the LineageOS
# decompiler (see sepolicy-decompiled/system_ext/private/opluscamera_app.te).
#
# Rules whose target type does not exist in EvolutionX and is registered only
# by the ColorOS system_server extension have been DROPPED - see DROPPED.md.

app_domain(opluscamera_app)
net_domain(opluscamera_app)
binder_service(opluscamera_app)

typeattribute opluscamera_app coredomain;

# CIL: (typeattributeset hal_oplus_performance_client (... opluscamera_app ...))
# Our tree names this attribute vendor_hal_oplus_performance_client, declared
# by vendor_hal_attribute(oplus_performance) in
# hardware/oplus/sepolicy/qti/public/attributes (a SYSTEM_EXT_PUBLIC dir, so it
# is visible from here).
hal_client_domain(opluscamera_app, vendor_hal_oplus_performance)

###
### Properties
###
# CIL 7009: (allow opluscamera_app system_oplus_radio_prop (file (read getattr map open)))
get_prop(opluscamera_app, system_oplus_radio_prop)
# CIL 9553: (allow opluscamera_app vendor_persist_camera_prop (file ...))
get_prop(opluscamera_app, vendor_persist_camera_prop)
# CIL 7006-7008 / 7029-7031 (+ property_socket write + init connectto,
# which set_prop() emits for us)
set_prop(opluscamera_app, exported_system_prop)
set_prop(opluscamera_app, system_prop)

###
### AOSP framework services - all of these types already exist in
### system/sepolicy/public/service.te, so these rules are portable as-is.
###
allow opluscamera_app {
    activity_service
    activity_task_service
    app_api_service
    audio_service
    audioserver_service
    autofill_service
    battery_service
    batteryproperties_service
    batterystats_service
    bluetooth_manager_service
    cameraserver_service
    clipboard_service
    content_service
    device_policy_service
    device_state_service
    fingerprint_service
    gpu_service
    hal_system_suspend_service
    location_service
    media_session_service
    mediaextractor_service
    mediametrics_service
    mediaserver_service
    mount_service
    netstats_service
    notification_service
    package_native_service
    permission_checker_service
    power_service
    radio_service
    sensorservice_service
    shortcut_service
    statusbar_service
    surfaceflinger_service
    telecom_service
    tethering_service
    thermal_service
    trust_service
    uimode_service
    user_service
    vibrator_manager_service
    webviewupdate_service
    wifi_service
}:service_manager find;

###
### OPlus/QTI services whose TYPES already exist in our tree.
### (horae_service   - hardware/oplus/sepolicy/qti/private/service.te
###  osense_service  - hardware/oplus/sepolicy/qti/public/service.te
###  vendor_perf_service - device/qcom/sepolicy/generic/private/service.te)
###
allow opluscamera_app {
    horae_service
    osense_service
    vendor_perf_service
}:service_manager find;

###
### Binder
###
# CIL 6998
allow opluscamera_app gpuservice:binder { call transfer };
# CIL 7014-7016
binder_call(opluscamera_app, system_suspend_server)

###
### cgroup / scheduler tuning (CIL 7013)
###
allow opluscamera_app cgroup:file { open read write };

###
### App-private data (CIL 9551-9552)
###
allow opluscamera_app opluscamera_app_data_file:dir create_dir_perms;
allow opluscamera_app opluscamera_app_data_file:file create_file_perms;

###
### Camera RUS (remote update service) config under /data/system/camera_rus
### CIL 7010-7011
###
allow opluscamera_app data_system_camera_rus:dir { add_name create getattr open read rename search setattr write };
allow opluscamera_app data_system_camera_rus:file { append create getattr open read rename setattr unlink write };

###
### /data/vendor/camera_update et al.  Type already exists in
### hardware/oplus/sepolicy/qti/vendor/file.te - but note it is declared in a
### VENDOR dir, so this pair of rules must move to the vendor half.
### See vendor/opluscamera_app.te.  (CIL 9549-9550)
###

###
### ashmem ioctls on the app's own tmpfs objects.
### app_domain() already grants { execute getattr map read write }; stock adds
### ioctl + the 0x7701-0x770b xperm range (ASHMEM_SET_NAME .. ASHMEM_PURGE_ALL_CACHES).
### CIL 6941-6942
###
allow opluscamera_app appdomain_tmpfs:file ioctl;
allowxperm opluscamera_app appdomain_tmpfs:file ioctl { 0x7701-0x770b };

###
### OPlus binder introspection node /proc/oplus_binder  (CIL 7021-7023)
### ioctl 0x6900 is OPlus's binder-proc control ioctl.
###
allow opluscamera_app oplus_binder_proc:dir search;
allow opluscamera_app oplus_binder_proc:file rw_file_perms;
allowxperm opluscamera_app oplus_binder_proc:file ioctl { 0x6900 };

###
### OPlus AI zero-copy fs (/dev/aizerofs + its module params).  CIL 7025-7026.
### Only useful if the oplus_bsp_aizerofs kernel module is present; harmless
### otherwise (the genfscon/file_contexts entries simply never match).
###
allow opluscamera_app oplus_aizerofs_device:chr_file r_file_perms;
allow opluscamera_app sysfs_aizerofs:file r_file_perms;
