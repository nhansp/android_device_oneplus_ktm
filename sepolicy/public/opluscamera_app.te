# OPlus stock camera app domain.
#
# MUST live in a SYSTEM_EXT_PUBLIC_SEPOLICY_DIRS dir so the type is exported
# into plat_pub_versioned.cil and can be referenced from BOARD_VENDOR_SEPOLICY
# rules (stock does exactly this: the vendor CIL refers to
# "opluscamera_app_202404").
#
# Source: ktm-16.0.10 system_ext_sepolicy.cil:943 "(type opluscamera_app)"
#         attribute membership from (typeattributeset ...) -> domain,
#         mlstrustedsubject  (appdomain/coredomain/netdomain/binderservicedomain
#         come from the macros in the private .te)
type opluscamera_app, domain, mlstrustedsubject;
