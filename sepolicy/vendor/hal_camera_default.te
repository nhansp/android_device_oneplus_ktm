# ktm-local hal_camera_default delta.
#
# NOT placed in hardware/oplus: every type these rules reference
# (proc_flash_light_file, oplus_sys_motor_file, cam_laser_sysfs,
# persist_camera_calibration_file, vendor_camera_remote_dump_file) is declared
# in device/oneplus/ktm/sepolicy/vendor/file.te, so putting the rules in the
# shared repo would break any other oplus device that lacks those types.
#
# Our tree already carries a substantial OPlus hal_camera_default policy.  This
# file contains only what the ktm-16.0.10 stock policy has and our tree does
# NOT, restricted to things the camera stack actually needs.  277 CIL lines
# mention hal_camera_default; most are QTI-generic and already provided by
# device/qcom/sepolicy_vndr/sm8750.
#
# ALREADY COVERED by our tree - do NOT re-add (verified by grep):
#   hal_client_domain(hal_camera_default, vendor_hal_oplus_cammidasservice)  = stock hal_midas_aidl_client
#   hal_client_domain(hal_camera_default, vendor_hal_oplus_osense)           = stock hal_osense_client
#   hal_client_domain(hal_camera_default, vendor_hal_oplus_performance)      = stock hal_oplus_performance_client
#   hal_client_domain(hal_camera_default, vendor_hal_oplus_urcc)             = stock hal_urcc_client
#   hal_client_domain(hal_camera_default, vendor_hal_oplus_charger)          = stock hal_charger_* rules
#   hal_client_domain(hal_camera_default, vendor_hal_oplus_commondcs)        = stock commondcs_aidl_service
#   add_service(hal_camera_default, hal_oplus_aon_aidl_service)              = stock hal_oplus_aon_server / oplus_hal_aon_service
#   allow ... vendor_hal_orms_hwservice / vendor_hal_osense_hwservice        = stock hal_orms_hwservice / hal_osense_client_hwservice
#   hal_attribute_hwservice(hal_camera, vendor_hal_camera_extension_hwservice) = stock hal_cameraextension_hwservice
#   vendor_camera_turbo_device / vendor_persist_camera_file / vendor_explorer_*
#   set_prop(hal_camera_default, vendor_camera_prop)                         = stock vendor_oplus_prop
#                                    (our property_contexts already maps
#                                     vendor.oplus.camera. -> vendor_camera_prop)
#
# ALSO ALREADY COVERED, and this is the important one: our
# hardware/oplus/sepolicy/qti/vendor/service_contexts labels the three OPlus
# camera AIDL services that hal_camera_default hosts IN-PROCESS
#   vendor.oplus.hardware.camera_rfi.ICameraRfiService/default
#   vendor.oplus.hardware.cameraextension.ICameraExtensionService/default
#   vendor.oplus.hardware.sendextcamcmd.ISendExtCamCmdService/default
# as plain hal_camera_service, and hwservice_contexts labels the sendextcamcmd
# and cammidasservice HIDL nodes as hal_camera_hwservice.  AOSP's
# hal_attribute_service(camera, hal_camera_service) then gives
# add_service(hal_camera_server, hal_camera_service) for free, so stock's
# hal_sendextcamcmd_server / hal_camera_rfi_server / hal_cameraextension_aidl_server
# attributes need no equivalent at all.  (Evidence that these really are
# in-process: the dump has NO standalone binaries for them, only
# odm/lib64/vendor.oplus.hardware.{sendextcamcmd,camera_rfi}-V1-service-impl.so
# plus odm/etc/vintf/manifest fragments, and
# `strings vendor/lib64/hw/camera.qcom.so` contains
# "vendor.oplus.hardware.camera_rfi-V1-service-impl.so".)

###
### GENUINELY MISSING - kernel/proc/sysfs nodes.  These need the type decls in
### file.te / device.te and the genfscon entries in genfs_contexts (both in
### this directory).
###

# /proc/oplus_scheduler/sched_assist  (CIL 17752-17753)
allow hal_camera_default oplus_scheduler_sched_assist_proc:dir { read search };
allow hal_camera_default oplus_scheduler_sched_assist_proc:file { getattr open read write };
# /proc/oplus_scheduler/sched_assist/scene  (CIL 13750)
allow hal_camera_default oplus_sched_assist_scene_proc:file rw_file_perms;

# /proc/cam_kern_fb - camera kernel feedback  (CIL 17760)
allow hal_camera_default oplus_proc_cam_kern_fb:file rw_file_perms;

# /proc/oplus_cl/cl_ctrl  (CIL 17757-17758)
allow hal_camera_default proc_cl_ctrl:dir search;
allow hal_camera_default proc_cl_ctrl:file { getattr ioctl open read setattr write };

# frame boost sysctl, incl. 13 discrete ioctls  (CIL 17769-17783)
allow hal_camera_default proc_frame_boost_sys_ctrl:dir search;
allow hal_camera_default proc_frame_boost_sys_ctrl:file { getattr ioctl open read setattr write };
allowxperm hal_camera_default proc_frame_boost_sys_ctrl:file ioctl { 0xf000-0xf00c };

# /dev/osvelte  (CIL 17767-17768)
allow hal_camera_default osvelte_device:chr_file { ioctl open read write };
allowxperm hal_camera_default osvelte_device:chr_file ioctl { 0xfa01-0xfa03 };

# flashlight proc node  (CIL 17672)
allow hal_camera_default proc_flash_light_file:file { open read write };

# motor (pop-up / periscope) sysfs  (CIL 17673-17675)
allow hal_camera_default oplus_sys_motor_file:dir { getattr search };
allow hal_camera_default oplus_sys_motor_file:file rw_file_perms;
allow hal_camera_default oplus_sys_motor_file:lnk_file r_file_perms;

# ToF / laser AF sysfs  (CIL 17693-17694)
allow hal_camera_default cam_laser_sysfs:dir { open read search };
allow hal_camera_default cam_laser_sysfs:file { open read write };

# /mnt/vendor/persist/dual_camera_calibration  (CIL 17701-17702)
allow hal_camera_default persist_camera_calibration_file:dir { add_name create open read search write };
allow hal_camera_default persist_camera_calibration_file:file create_file_perms;

# /data/vendor/camera_remote_dump  (CIL 17682-17683)
allow hal_camera_default vendor_camera_remote_dump_file:dir create_dir_perms;
allow hal_camera_default vendor_camera_remote_dump_file:file create_file_perms;
