<resources>
    <!-- The properties of the face auth front camera for outer display in pixels.
         Taken from the stock ro.oplus.display.screenhole.positon=599,45:673,119,
         which gives a 74x74 box centered on 636,82. -->
    <integer-array name="config_face_auth_props">
        <item>636</item>
        <item>82</item>
        <item>37</item>
    </integer-array>

    <!-- Logical id of the front camera. config_face_auth_props is not read
         unless this is set. -->
    <string translatable="false" name="config_protectedCameraId">1</string>

    <!-- Bounding path of the front camera. Must be parsable whenever
         config_protectedCameraId is set, even though it is only drawn when
         config_enableDisplayCutoutProtection is true. -->
    <string translatable="false" name="config_frontBuiltInDisplayCutoutProtection">m 688,82 a 52,52 0 0 0 -104,0 52,52 0 0 0 104,0 z</string>

    <!-- Comma-separated list of packages to exclude from camera protection e.g.
    "com.android.systemui,com.android.xyz" -->
    <string translatable="false" name="config_cameraProtectionExcludedPackages">com.google.android.as</string>

    <!--  Flag to turn on the rendering of the above path or not  -->
    <bool name="config_enableDisplayCutoutProtection">true</bool>
</resources>
