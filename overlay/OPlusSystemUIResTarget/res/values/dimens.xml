<resources>
    <!-- the padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">20dp</dimen>

    <!-- the padding on the end of the statusbar -->
    <dimen name="status_bar_padding_end">20dp</dimen>

    <!-- the padding on the top of the statusbar -->
    <dimen name="status_bar_padding_top">4dp</dimen>

    <!-- Matches ongoing_appops_dot_min_padding, which is enforced on the end
         only, so that both ends of the statusbar are inset equally -->
    <dimen name="rounded_corner_content_padding">20dp</dimen>

    <!-- Inset the shade and QS panel to match the statusbar. Overriding these
         aliases rather than notification_side_paddings_single, which also backs
         notification_section_divider_height. -->
    <dimen name="qs_horizontal_margin">20dp</dimen>
    <dimen name="notification_shade_content_margin_horizontal">20dp</dimen>

    <!-- split_shade_status_bar pads both sides from this; its start is
         overridden at runtime, so the end was the only one left at 16dp. -->
    <dimen name="qs_panel_padding">20dp</dimen>

    <!-- Location on the screen of the center of the physical power button. This is a reasonable
    default that should be overridden by device-specific overlays. -->
    <!-- Hidden on a single-user device, but still reserves width to the end
         of the keyguard status icons. -->
    <dimen name="multi_user_avatar_keyguard_size">0dp</dimen>

    <dimen name="physical_power_button_center_screen_location_y">1000px</dimen>

    <!-- Default device corner radius, used for assist UI -->
    <dimen name="config_rounded_mask_size">156px</dimen>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">55.82</item>
</resources>
